{
  "name": "brandspace-forge",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "approval:typecheck": "tsc -p tsconfig.approval-scripts.json",
    "agent:typecheck": "tsc -p tsconfig.agent-scripts.json",
    "test": "turbo test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate --workspace=@forge/database",
    "db:migrate": "npm run db:migrate --workspace=@forge/database",
    "db:deploy": "npm run db:deploy --workspace=@forge/database",
    "db:studio": "npm run db:studio --workspace=@forge/database",
    "drive:check": "tsx scripts/drive-check.ts",
    "drive:auth": "tsx scripts/drive-auth.ts",
    "drive:ingest": "tsx scripts/drive-ingest.ts",
    "media:check": "tsx scripts/media-check.ts",
    "media:analyze": "tsx scripts/media-analyze.ts",
    "media:prepare": "tsx scripts/media-prepare.ts",
    "media:transcribe": "tsx scripts/media-transcribe.ts",
    "media:scenes": "tsx scripts/media-scenes.ts",
    "media:understand": "tsx scripts/media-understand.ts",
    "reel:create": "tsx scripts/reel-create.ts",
    "reel:plan": "tsx scripts/reel-plan.ts",
    "reel:inspect": "tsx scripts/reel-inspect.ts",
    "reel:render": "tsx scripts/reel-render.ts",
    "reel:qa": "tsx scripts/reel-qa.ts",
    "reel:qa:creative": "tsx scripts/reel-creative-qa.ts",
    "reel:approval": "tsx scripts/reel-approval.ts",
    "reel:schedule": "tsx scripts/reel-schedule.ts",
    "reel:queue:reconcile": "tsx scripts/reel-queue-reconcile.ts",
    "instagram:account:import": "tsx scripts/instagram-account-import.ts",
    "instagram:account:list": "tsx scripts/instagram-account-list.ts",
    "agent:token": "tsx scripts/agent-token.ts",
    "social:token:rotate": "tsx scripts/social-token-rotate.ts",
    "scale:mcp-load": "tsx scripts/mcp-load.ts",
    "publication:media": "tsx scripts/publication-media.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
