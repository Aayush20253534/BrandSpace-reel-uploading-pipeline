NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Phase 2+
DATABASE_URL=postgresql://brandspace:brandspace@localhost:5432/brandspace_forge
REDIS_URL=redis://localhost:6379

# Google Drive is the canonical media store.
# Prefer a Shared Drive for organization-owned media.
GOOGLE_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the private key only in a secret manager/environment at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Future providers; intentionally unused in Phase 1.
OPENAI_API_KEY=
META_APP_ID=
META_APP_SECRET=
