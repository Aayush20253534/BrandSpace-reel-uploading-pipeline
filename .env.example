NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Phase 2: use a managed PostgreSQL database (Neon is a good fit).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Phase 10+
REDIS_URL=

# Phase 11: encrypt per-client social access tokens at rest.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Google Drive is the canonical media store.
# My Drive development: OAuth authenticates as the Google account that owns the files.
# Production preference: shared-drive + service-account.
GOOGLE_DRIVE_MODE=my-drive
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Phase 11: Meta / Instagram Login.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/social/instagram/callback

# Future providers.
OPENAI_API_KEY=
